# ==============================================================================
# Multilingual AI Meeting Platform - Environment Configuration Blueprint
# ==============================================================================
# Copy this file to .env and replace placeholders with real secret values.
# NEVER commit .env into source control!

# --- System & Environment ---
APP_ENV=development
APP_NAME=multilingual-ai-meeting-platform
DEBUG=true
LOG_LEVEL=INFO

# --- Control Plane (FastAPI REST API) ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=generate-a-secure-random-secret-key-at-least-64-characters-long
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Realtime Gateway (WebSocket) ---
WS_HOST=0.0.0.0
WS_PORT=8001
WS_HEARTBEAT_INTERVAL_SEC=15
WS_HEARTBEAT_TIMEOUT_SEC=45
MAX_WS_CONNECTIONS_PER_ROOM=200

# --- Database & Supabase (PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Supabase Auth & Storage
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-keep-secure

# --- Redis 7.2 (Streams & Pub/Sub) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_STREAM_RETENTION_MS=86400000

# --- LiveKit WebRTC SFU ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_EGRESS_ENABLED=false

# --- AI & ML Workers Configuration ---
# Hugging Face Hub (Token for gated models e.g., PyAnnote)
HF_TOKEN=hf_your_huggingface_token_here

# Speech-to-Text (STT) Worker
STT_MODEL_NAME=Systran/faster-whisper-medium
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_VAD_THRESHOLD=0.5
STT_MAX_CHUNK_DURATION_SEC=3.0

# Translation (NMT) Worker
NMT_MODEL_NAME=facebook/nllb-200-distilled-600M
NMT_DEVICE=cuda
NMT_BATCH_SIZE=8
NMT_MAX_INPUT_LENGTH=512

# Text-to-Speech (TTS) Worker
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cuda
TTS_SAMPLE_RATE=24000
TTS_WATERMARK_FREQUENCY_HZ=20000
TTS_WATERMARK_AMPLITUDE=0.005

# Diarization (Speaker ID) Worker
DIARIZATION_MODEL_NAME=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cuda

# Meeting Assistant (RAG / LLM)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Audio Pipeline Invariants ---
AUDIO_INCOMING_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FRAME_DURATION_MS=20
AUDIO_WATERMARK_DETECTION_THRESHOLD=0.001

# --- Security, Cryptography & Privacy ---
DATA_ENCRYPTION_KEY=32-byte-base64-encoded-symmetric-key-for-transcripts-at-rest
TOKEN_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30
RATE_LIMIT_PER_MINUTE=120

# --- Observability (OpenTelemetry & Prometheus) ---
OTEL_SERVICE_NAME=multilingual-meeting-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
PROMETHEUS_METRICS_PORT=9090

# --- Web Application (Next.js 14) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8001
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
