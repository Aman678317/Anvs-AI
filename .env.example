# Application Environment & Runtime
APP_ENV=development
APP_NAME=multilingual-ai-meeting-platform
DEBUG=false
LOG_LEVEL=INFO

# API Gateways & Security
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secure-64-byte-secret-key-here
WS_HOST=0.0.0.0
WS_PORT=8001

# Supabase PostgreSQL (Transaction Mode Pooler for App Queries)
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase PostgreSQL (Session Mode Pooler for Migrations)
DIRECT_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Redis & LiveKit SFU
REDIS_URL=redis://localhost:6379/0
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Supabase Auth
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-key-32-chars-min
SUPABASE_JWT_ALGORITHM=HS256

# Speech & Translation Workers (mock, whisper, nllb, piper, pyannote)
STT_ENGINE_TYPE=mock
NMT_ENGINE_TYPE=mock
TTS_ENGINE_TYPE=mock
SPEAKER_ENGINE_TYPE=mock

# Meeting Assistant Copilot (mock, openai, nvidia)
ASSISTANT_ENGINE_TYPE=nvidia
ASSISTANT_MODEL_NAME=meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=your-nvapi-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=your-openai-or-nim-api-key-here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
