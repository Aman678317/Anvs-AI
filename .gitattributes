# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly ensure code, config, and markup files use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
